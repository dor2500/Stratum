<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Stratum.Core</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Squid-Box.SevenZipSharp" Version="1.6.2.24" />
  </ItemGroup>

  <!-- The 7-Zip engine (LGPL, with the unRAR restriction). See third_party/7zip/License.txt. -->
  <ItemGroup>
    <None Include="..\..\third_party\7zip\7z.dll" Link="7z.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Stratum.Core.Tests" />
  </ItemGroup>

</Project>
