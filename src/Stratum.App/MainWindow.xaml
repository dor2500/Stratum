<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Stratum.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stratum.Shell"
    Title="Stratum">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True"
          DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop" Loaded="Root_Loaded">
        <Grid.Resources>
            <LinearGradientBrush x:Key="GreenFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4CCB6A" Offset="0" /><GradientStop Color="#1E9A44" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="BlueFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FA3FF" Offset="0" /><GradientStop Color="#2467D8" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="SkyFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A8D8FF" Offset="0" /><GradientStop Color="#5AA9F5" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="RedFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F4776F" Offset="0" /><GradientStop Color="#D63C3A" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="AmberFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFC24A" Offset="0" /><GradientStop Color="#EE8F12" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="VioletFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#9B7BF7" Offset="0" /><GradientStop Color="#6A43D6" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="SteelFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#A9B4C1" Offset="0" /><GradientStop Color="#6B7785" Offset="1" /></LinearGradientBrush>
            <LinearGradientBrush x:Key="PaperFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#FFFFFF" Offset="0" /><GradientStop Color="#E4EBF5" Offset="1" /></LinearGradientBrush>
            <!-- Large "icon over label" toolbar button, the classic archiver layout. -->
            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="88" />
                <Setter Property="Height" Value="74" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="ToolLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,5,0,0" />
            </Style>
            <Style x:Key="ColumnHeader" TargetType="HyperlinkButton">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0" VerticalAlignment="Center">
                <Image Source="Assets/Stratum.ico" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Text="Stratum" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Menu -->
        <MenuBar Grid.Row="1" Margin="4,0,0,0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Open archive…" Click="Open_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Change folder…" Click="ChangeFolder_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="D" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CloseArchiveItem" Text="Close archive" Click="CloseArchive_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="W" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Copy full names to clipboard" Click="CopyNames_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Select all" Click="SelectAll_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="A" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Invert selection" Click="InvertSelection_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Commands">
                <MenuFlyoutItem Text="Add files to archive" Click="Add_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="A" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Extract to a specified folder" Click="Extract_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="E" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Test archived files" Click="Test_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="T" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="View file" Click="View_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="V" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Delete files" Click="Delete_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Extract without confirmation" Click="ExtractNow_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="W" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Tools">
                <MenuFlyoutItem Text="Find files" Click="Find_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F3" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Show information" Click="Info_Click">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Menu" Key="I" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Options">
                <MenuFlyoutSubItem Text="Themes">
                    <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Use system setting" GroupName="Theme" Tag="System" Click="Theme_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                    <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                </MenuFlyoutSubItem>
                <ToggleMenuFlyoutItem x:Name="ExplorerToggle" Text="Show in Explorer right-click menu" Click="ExplorerToggle_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About Stratum" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- Toolbar: large full-colour icons over a label. The artwork is Stratum's own. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="2" Margin="8,2,8,6">
            <Button x:Name="AddButton" Style="{StaticResource ToolButton}" Click="Add_Click" ToolTipService.ToolTip="Add files to archive (Alt+A)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Rectangle Canvas.Left="3" Canvas.Top="4" Width="21" Height="6.5" RadiusX="2" RadiusY="2" Fill="{StaticResource AmberFill}" />
                        <Rectangle Canvas.Left="3" Canvas.Top="12" Width="21" Height="6.5" RadiusX="2" RadiusY="2" Fill="{StaticResource BlueFill}" />
                        <Rectangle Canvas.Left="3" Canvas.Top="20" Width="21" Height="6.5" RadiusX="2" RadiusY="2" Fill="{StaticResource VioletFill}" />
                        <Rectangle Canvas.Left="6" Canvas.Top="6.2" Width="5" Height="2" RadiusX="1" RadiusY="1" Fill="#B3FFFFFF" />
                        <Rectangle Canvas.Left="6" Canvas.Top="14.2" Width="5" Height="2" RadiusX="1" RadiusY="1" Fill="#B3FFFFFF" />
                        <Rectangle Canvas.Left="6" Canvas.Top="22.2" Width="5" Height="2" RadiusX="1" RadiusY="1" Fill="#B3FFFFFF" />
                        <Ellipse Canvas.Left="16.5" Canvas.Top="16.5" Width="14.5" Height="14.5" Fill="{StaticResource GreenFill}" Stroke="White" StrokeThickness="1.4" />
                        <Rectangle Canvas.Left="22.7" Canvas.Top="19.8" Width="2.1" Height="8" RadiusX="1" RadiusY="1" Fill="White" />
                        <Rectangle Canvas.Left="19.75" Canvas.Top="22.7" Width="8" Height="2.1" RadiusX="1" RadiusY="1" Fill="White" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Add" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
            <Button x:Name="ExtractButton" Style="{StaticResource ToolButton}" Click="Extract_Click" ToolTipService.ToolTip="Extract to a specified folder (Alt+E)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Path Fill="{StaticResource BlueFill}" Data="M2,8 a2,2 0 0 1 2,-2 h7.5 l3,3 h13.5 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-24 a2,2 0 0 1 -2,-2 z" />
                        <Rectangle Canvas.Left="2" Canvas.Top="12" Width="28" Height="15" RadiusX="2" RadiusY="2" Fill="{StaticResource SkyFill}" />
                        <Ellipse Canvas.Left="16.5" Canvas.Top="16.5" Width="14.5" Height="14.5" Fill="{StaticResource AmberFill}" Stroke="White" StrokeThickness="1.4" />
                        <Path Stroke="White" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M20.2,23.75 h7 M24.4,20.6 l3,3.15 l-3,3.15" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Extract To" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
            <Button x:Name="TestButton" Style="{StaticResource ToolButton}" Click="Test_Click" ToolTipService.ToolTip="Test archived files (Alt+T)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Rectangle Canvas.Left="5" Canvas.Top="5" Width="22" Height="25" RadiusX="3" RadiusY="3" Fill="{StaticResource RedFill}" />
                        <Rectangle Canvas.Left="8" Canvas.Top="9" Width="16" Height="18" RadiusX="1.5" RadiusY="1.5" Fill="White" />
                        <Rectangle Canvas.Left="11.5" Canvas.Top="2.5" Width="9" Height="6" RadiusX="2" RadiusY="2" Fill="{StaticResource SteelFill}" />
                        <Path Stroke="#1FA34A" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M11.5,18.5 l3.2,3.2 l6,-7" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Test" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
            <Button x:Name="ViewButton" Style="{StaticResource ToolButton}" Click="View_Click" ToolTipService.ToolTip="View file (Alt+V)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Path Fill="{StaticResource PaperFill}" Stroke="#8FA3BD" StrokeThickness="1" Data="M6,4 a2,2 0 0 1 2,-2 h10 l7,7 v17 a2,2 0 0 1 -2,2 h-15 a2,2 0 0 1 -2,-2 z" />
                        <Path Fill="#C9D6E8" Data="M18,2 l7,7 h-5 a2,2 0 0 1 -2,-2 z" />
                        <Rectangle Canvas.Left="9.5" Canvas.Top="13" Width="11" Height="1.8" RadiusX="0.9" RadiusY="0.9" Fill="#9DB0C8" />
                        <Rectangle Canvas.Left="9.5" Canvas.Top="17" Width="8" Height="1.8" RadiusX="0.9" RadiusY="0.9" Fill="#9DB0C8" />
                        <Ellipse Canvas.Left="14.5" Canvas.Top="14.5" Width="12" Height="12" Fill="#99D8C7FF" Stroke="{StaticResource VioletFill}" StrokeThickness="2.4" />
                        <Path Stroke="{StaticResource VioletFill}" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M25,25 l4.3,4.3" />
                    </Canvas></Viewbox>
                    <TextBlock Text="View" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
            <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTipService.ToolTip="Delete files (Del)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Rectangle Canvas.Left="12" Canvas.Top="2.5" Width="8" Height="4.5" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource SteelFill}" />
                        <Rectangle Canvas.Left="4.5" Canvas.Top="5.5" Width="23" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource SteelFill}" />
                        <Path Fill="{StaticResource RedFill}" Data="M7,11 h18 l-1.5,17 a2.2,2.2 0 0 1 -2.2,2 h-10.6 a2.2,2.2 0 0 1 -2.2,-2 z" />
                        <Rectangle Canvas.Left="11.6" Canvas.Top="14" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#CCFFFFFF" />
                        <Rectangle Canvas.Left="15" Canvas.Top="14" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#CCFFFFFF" />
                        <Rectangle Canvas.Left="18.4" Canvas.Top="14" Width="2" Height="12" RadiusX="1" RadiusY="1" Fill="#CCFFFFFF" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Delete" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
            <Border Width="1" Margin="6,12" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button x:Name="FindButton" Style="{StaticResource ToolButton}" Click="Find_Click" ToolTipService.ToolTip="Find files (F3)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Path Stroke="{StaticResource SteelFill}" StrokeThickness="4.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20.5,20.5 l8,8" />
                        <Ellipse Canvas.Left="3" Canvas.Top="3" Width="21" Height="21" Fill="{StaticResource SkyFill}" Stroke="{StaticResource BlueFill}" StrokeThickness="2.8" />
                        <Path Stroke="#B3FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8.5,13 a5.5,5.5 0 0 1 5,-5" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Find" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
            <Button x:Name="InfoButton" Style="{StaticResource ToolButton}" Click="Info_Click" ToolTipService.ToolTip="Show archive information (Alt+I)">
                <StackPanel>
                    <Viewbox Width="36" Height="36"><Canvas Width="32" Height="32">
                        <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="27" Height="27" Fill="{StaticResource BlueFill}" />
                        <Ellipse Canvas.Left="5" Canvas.Top="5" Width="22" Height="22" Stroke="#66FFFFFF" StrokeThickness="1.2" />
                        <Ellipse Canvas.Left="14" Canvas.Top="8" Width="4" Height="4" Fill="White" />
                        <Rectangle Canvas.Left="14" Canvas.Top="14" Width="4" Height="10.5" RadiusX="1.6" RadiusY="1.6" Fill="White" />
                    </Canvas></Viewbox>
                    <TextBlock Text="Info" Style="{StaticResource ToolLabel}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Address bar -->
        <Grid Grid.Row="3" Margin="8,0,8,8" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="Up_Click" Padding="8,7" ToolTipService.ToolTip="Up one level (Backspace)">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <TextBox x:Name="PathBox" Grid.Column="1" KeyDown="PathBox_KeyDown" IsSpellCheckEnabled="False" />
            <AutoSuggestBox x:Name="FilterBox" Grid.Column="2" PlaceholderText="Find in this folder" QueryIcon="Find"
                            TextChanged="FilterBox_TextChanged" />
        </Grid>

        <!-- File list -->
        <Grid Grid.Row="4" Margin="8,0,8,8">
            <Border CornerRadius="6" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderGrid" Padding="24,4,24,4" ColumnSpacing="12"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Grid.Column="1" Content="Name" Tag="name" Click="Sort_Click" Style="{StaticResource ColumnHeader}" />
                        <HyperlinkButton Grid.Column="2" Content="Size" Tag="size" Click="Sort_Click" Style="{StaticResource ColumnHeader}" HorizontalAlignment="Right" />
                        <HyperlinkButton Grid.Column="3" Content="Type" Tag="type" Click="Sort_Click" Style="{StaticResource ColumnHeader}" />
                        <HyperlinkButton Grid.Column="4" Content="Modified" Tag="modified" Click="Sort_Click" Style="{StaticResource ColumnHeader}" />
                        <HyperlinkButton Grid.Column="5" Content="CRC32" Tag="crc" Click="Sort_Click" Style="{StaticResource ColumnHeader}" />
                    </Grid>

                    <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Extended" Padding="0,2"
                              CanDragItems="True" IsDoubleTapEnabled="True"
                              DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted"
                              DoubleTapped="FileList_DoubleTapped" KeyDown="FileList_KeyDown"
                              SelectionChanged="FileList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="Padding" Value="20,0,20,0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="View file" Click="View_Click" />
                                <MenuFlyoutItem Text="Extract to a specified folder" Click="Extract_Click" />
                                <MenuFlyoutItem Text="Add files to archive" Click="Add_Click" />
                                <MenuFlyoutItem Text="Test archived files" Click="Test_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete files" Click="Delete_Click" />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{x:Bind Icon}" Width="20" Height="20" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Glyph="&#xE72E;" FontSize="11" Visibility="{x:Bind LockVisibility}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  ToolTipService.ToolTip="Encrypted" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TypeText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind CrcText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               FontFamily="Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyFolderText" Grid.Row="1" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- Drop target highlight -->
            <Border x:Name="DropOverlay" Opacity="0" IsHitTestVisible="False" CornerRadius="8"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Border.OpacityTransition>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="36" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DropText" Text="Drop to open" Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="Notice" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" IsOpen="False" />
        </Grid>

        <!-- Running job -->
        <Grid x:Name="JobPanel" Grid.Row="5" Margin="8,0,8,8" Padding="16,10" ColumnSpacing="16" CornerRadius="6" Visibility="Collapsed"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.Transitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="16" /></TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="JobTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar x:Name="JobProgress" Maximum="100" />
                <TextBlock x:Name="JobDetail" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Click="Cancel_Click" />
        </Grid>

        <!-- Status bar: selection on the left, totals on the right -->
        <Grid Grid.Row="6" Padding="14,5,14,7" ColumnSpacing="16"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="TotalText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
