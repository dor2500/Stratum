<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Stratum.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stratum.Shell"
    Title="Stratum">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Transparent" AllowDrop="True"
          DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop" Loaded="Root_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xF012;" FontSize="12" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock x:Name="TitleText" Text="Stratum" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </Grid>

        <!-- Commands -->
        <Grid Grid.Row="1" Margin="8,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <CommandBar Background="Transparent" DefaultLabelPosition="Right" HorizontalAlignment="Left" IsDynamicOverflowEnabled="True">
                <AppBarButton x:Name="OpenButton" Label="Open" Click="Open_Click" ToolTipService.ToolTip="Open an archive (Ctrl+O)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8E5;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="NewButton" Label="New archive" ToolTipService.ToolTip="Compress files or a folder (Ctrl+N)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="From files…" Click="NewFromFiles_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="N" /></MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="From a folder…" Click="NewFromFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Name="ExtractButton" Label="Extract" Click="Extract_Click" IsEnabled="False" ToolTipService.ToolTip="Extract everything, or the selection (Ctrl+E)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE896;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="E" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="AddButton" Label="Add" Click="Add_Click" IsEnabled="False" ToolTipService.ToolTip="Add files to this archive">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8F4;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="TestButton" Label="Test" Click="Test_Click" IsEnabled="False" ToolTipService.ToolTip="Check the archive for damage (Ctrl+T)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE9D5;" /></AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="T" /></AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Name="DeleteButton" Label="Delete" Click="Delete_Click" IsEnabled="False" ToolTipService.ToolTip="Remove the selection from the archive (Del)">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar>

            <Button Grid.Column="1" VerticalAlignment="Center" Padding="8" Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuFlyoutSubItem Text="Theme">
                            <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE793;" /></MenuFlyoutSubItem.Icon>
                            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Use system setting" GroupName="Theme" Tag="System" Click="Theme_Click" />
                            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="Theme" Tag="Light" Click="Theme_Click" />
                            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="Theme" Tag="Dark" Click="Theme_Click" />
                        </MenuFlyoutSubItem>
                        <ToggleMenuFlyoutItem x:Name="ExplorerToggle" Text="Show in Explorer right-click menu" Click="ExplorerToggle_Click">
                            <ToggleMenuFlyoutItem.Icon><FontIcon Glyph="&#xEC50;" /></ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="About Stratum" Click="About_Click">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Location inside the archive -->
        <Grid x:Name="NavBar" Grid.Row="2" Margin="16,4,16,8" ColumnSpacing="8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UpButton" Click="Up_Click" Padding="8" ToolTipService.ToolTip="Up one level (Backspace)">
                <FontIcon Glyph="&#xE74A;" FontSize="14" />
            </Button>
            <BreadcrumbBar x:Name="Crumbs" Grid.Column="1" VerticalAlignment="Center" ItemClicked="Crumbs_ItemClicked" />
            <AutoSuggestBox x:Name="FilterBox" Grid.Column="2" PlaceholderText="Filter this folder" QueryIcon="Find"
                            TextChanged="FilterBox_TextChanged" />
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="3" Margin="16,0,16,12">

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <StackPanel.Transitions>
                    <TransitionCollection><EntranceThemeTransition FromVerticalOffset="24" /></TransitionCollection>
                </StackPanel.Transitions>
                <Border Width="96" Height="96" CornerRadius="24" HorizontalAlignment="Center"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <FontIcon Glyph="&#xF012;" FontSize="40" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock Text="Drop an archive to open it" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="or drop files and folders to compress them" HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <Button Content="Open archive" Style="{StaticResource AccentButtonStyle}" Click="Open_Click" />
                    <Button Content="Compress files" Click="NewFromFiles_Click" />
                </StackPanel>
                <TextBlock Text="ZIP · 7Z · TAR · RAR (extract)" HorizontalAlignment="Center" Margin="0,8,0,0"
                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Browser -->
            <Border x:Name="Browser" Visibility="Collapsed" CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="28,6,28,6" ColumnSpacing="12"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Grid.Column="1" Content="Name" Tag="name" Click="Sort_Click" Padding="4,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Grid.Column="2" Content="Size" Tag="size" Click="Sort_Click" Padding="4,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <HyperlinkButton Grid.Column="3" Content="Modified" Tag="modified" Click="Sort_Click" Padding="4,2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="4" Text="Type" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Extended" Padding="4"
                              CanDragItems="True" IsDoubleTapEnabled="True"
                              DragItemsStarting="FileList_DragItemsStarting" DragItemsCompleted="FileList_DragItemsCompleted"
                              DoubleTapped="FileList_DoubleTapped" KeyDown="FileList_KeyDown"
                              SelectionChanged="FileList_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="38" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Open" Click="ContextOpen_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Extract…" Click="Extract_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE896;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Delete" Click="Delete_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ItemRow">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Opacity="{x:Bind IconOpacity}"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <FontIcon Glyph="&#xE72E;" FontSize="11" Visibility="{x:Bind LockVisibility}"
                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  ToolTipService.ToolTip="Encrypted" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ModifiedText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind TypeText}" VerticalAlignment="Center" Margin="4,0,0,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptyFolderText" Grid.Row="1" Text="Nothing here" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </Border>

            <!-- Drop target highlight -->
            <Border x:Name="DropOverlay" Opacity="0" IsHitTestVisible="False" CornerRadius="12"
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Border.OpacityTransition>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <FontIcon Glyph="&#xE896;" FontSize="36" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DropText" Text="Drop to open" Style="{StaticResource SubtitleTextBlockStyle}"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="Notice" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" IsOpen="False" />
        </Grid>

        <!-- Running job -->
        <Grid x:Name="JobPanel" Grid.Row="4" Margin="16,0,16,12" Padding="16,12" ColumnSpacing="16" CornerRadius="8" Visibility="Collapsed"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.Transitions>
                <TransitionCollection><EntranceThemeTransition FromVerticalOffset="16" /></TransitionCollection>
            </Grid.Transitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock x:Name="JobTitle" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ProgressBar x:Name="JobProgress" Maximum="100" />
                <TextBlock x:Name="JobDetail" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" VerticalAlignment="Center" Click="Cancel_Click" />
        </Grid>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="20,0,20,10" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
